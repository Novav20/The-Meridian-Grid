# Keep text files stable across Windows and Unix-like systems.
* text=auto
.gitattributes text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# These formats must not be modified by text normalization.
*.avif binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.webp binary
*.xlsx binary
